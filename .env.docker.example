# Copy to .env alongside docker-compose.yml. Every value here is the default
# compose already uses, so an empty .env changes nothing.

# --- Addresses ---------------------------------------------------------------
# What a *browser* uses. PUBLIC_API_URL is compiled into the client bundle, so
# changing it needs `docker compose up --build`, not just a restart. On a real
# deployment these become your domain, e.g. https://alwin.dev and
# https://api.alwin.dev.
PUBLIC_WEB_URL=http://localhost:3100
PUBLIC_API_URL=http://localhost:4100

# Host ports. Change these if 3100/4100 are taken; PUBLIC_* must agree.
WEB_PORT=3100
API_PORT=4100

# --- API ---------------------------------------------------------------------
LOG_LEVEL=info

# Mixed into every visitor hash, rotated daily. CHANGE THIS BEFORE THE SITE IS
# PUBLIC — it is the only thing keeping the analytics table from being a list of
# identifiable visitors. Any long random string will do:
#   openssl rand -hex 24
ANALYTICS_SALT=portfolio-dev-salt

# --- Contact email -----------------------------------------------------------
# With MAIL_ENABLED=false a submitted message is still stored in the database
# and the send is logged, so the form works without SMTP configured.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
