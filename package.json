{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Alwin's portfolio \u2014 Next.js front end with a shared TypeScript contract, deployed on Vercel.",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @portfolio/web dev",
    "build": "pnpm --filter @portfolio/web build",
    "start": "pnpm --filter @portfolio/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @portfolio/web test",
    "db:push": "pnpm --filter @portfolio/web db:push",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
