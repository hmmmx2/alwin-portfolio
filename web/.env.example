# Copy to .env.local. Nothing here is committed.
#
# Only the contact form and the analytics beacon read any of this; every page
# on the site is static and needs none of it.

# --- Site -------------------------------------------------------------------
# Canonical URL, used for Open Graph, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.alwint.dev

# --- Country allowlist ------------------------------------------------------
# ISO-3166-1 alpha-2, comma separated. Unset uses the built-in list. An absent
# x-vercel-ip-country header (local development) is always allowed, and crawlers
# are admitted from anywhere so the site stays indexed.
ALLOWED_COUNTRIES=US,MY,SG,GB,IE,FR,DE,JP,TW,CA,AU,NL,CH,NZ

# --- Database (Turso) -------------------------------------------------------
# libsql. A local file works for development; production wants a Turso URL.
TURSO_DATABASE_URL=file:./data/portfolio.db
TURSO_AUTH_TOKEN=

# --- Privacy ----------------------------------------------------------------
# Mixed into every visitor hash, rotated daily. Production REFUSES TO START on
# the value below, because it is public in this repository and would make every
# hash reproducible. Generate one with:  openssl rand -hex 24
ANALYTICS_SALT=portfolio-dev-salt

# Minimum plausible time to fill in the contact form, in milliseconds.
CONTACT_MIN_FILL_MS=2500

# --- Contact email ----------------------------------------------------------
# With MAIL_ENABLED=false a message is still stored and logged, so the form
# works without SMTP configured.
#
# Resend, sending from the domain. Preferred over a personal Gmail: the
# notification then shows the sender instead of "me", and delivery does not
# depend on someone's app password. Resend speaks SMTP, so no code changes --
# only these values. MAIL_USER is the literal string "resend"; the password is
# the API key.
MAIL_ENABLED=false
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=resend
MAIL_PASSWORD=
MAIL_FROM=contact@alwint.dev
MAIL_FROM_NAME=Alwin Tay Jing Xue
MAIL_TO=
