# Copy to .env.local.
#
# NEXT_PUBLIC_API_URL is baked into the client bundle at build time. A stale
# value here is the usual reason a deployed portfolio builds cleanly and then
# shows nothing — check it first when content or the contact form goes quiet.
NEXT_PUBLIC_API_URL=http://localhost:4100

# Used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.alwint.dev
