{
  "name": "@portfolio/web",
  "version": "1.0.0",
  "private": true,
  "description": "Alwin's portfolio front end — Next.js App Router, React Server Components, Tailwind v4.",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
