{
  "name": "@portfolio/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express + TypeScript API for the portfolio: content, contact, resume and analytics.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "clean": "rimraf dist data *.tsbuildinfo"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "@portfolio/shared": "workspace:*",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.38.4",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "nodemailer": "^6.10.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.18.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}
