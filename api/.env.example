# Copy to .env and adjust. Every value below is the built-in default.

NODE_ENV=development
PORT=4100
HOST=127.0.0.1
LOG_LEVEL=info

# libsql. Use file:./data/portfolio.db locally, or a Turso URL in production.
DATABASE_URL=file:./data/portfolio.db

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3100

# Path to the resume PDF. When the file is missing, /api/resume returns 404 and
# the web app hides the download link instead of showing a dead button.
RESUME_PATH=./assets/resume.pdf

# Mixed into every visitor hash. CHANGE THIS IN PRODUCTION — the hash is what
# stands between the analytics table and a per-visitor identifier.
ANALYTICS_SALT=portfolio-dev-salt

# Minimum plausible time to fill in the contact form, in milliseconds.
CONTACT_MIN_FILL_MS=2500

# Contact email delivery. With MAIL_ENABLED=false the message is still stored
# in the database and the send is logged instead.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
